{
  "name": "gleislicht",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Switzerland in motion — a cinematic railway visualisation built from Swiss open transport data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:boundary": "node scripts/ingest-boundary.mjs",
    "data:gtfs": "node scripts/ingest-gtfs.mjs",
    "data:day": "node scripts/ingest-gtfs.mjs --window-start 00:00 --window-end 24:00 --output public/data/swiss-rail-day-manifest.json --hub-output none --chunk-hours 3",
    "data:zurich": "node scripts/ingest-gtfs.mjs --modes all --bounds 8.45,47.32,8.63,47.44 --output public/data/zurich-city-morning.json --hub-output none",
    "data:zurich:shapes": "node scripts/enrich-zurich-shapes.mjs",
    "data:zvv": "node scripts/ingest-gtfs.mjs --modes all --bounds 8.32,47.15,9.02,47.72 --output public/data/zvv-region-morning.json --hub-output none",
    "data:zvv:shapes": "node scripts/enrich-zurich-shapes.mjs --snapshot public/data/zvv-region-morning.json",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@driftbox/engine": "^0.6.0",
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
