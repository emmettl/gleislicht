{
  "name": "gleislicht",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Switzerland in motion — a cinematic railway visualisation built from Swiss open transport data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "pages:prepare": "node scripts/prepare-pages-artifact.mjs",
    "check:architecture": "node scripts/check-edition-boundaries.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "worker:check": "tsc -p realtime-worker/tsconfig.json && tsc -p astra-worker/tsconfig.json",
    "worker:build": "npm run worker:build:realtime && npm run worker:build:astra",
    "worker:build:realtime": "wrangler deploy --config wrangler.realtime.jsonc --dry-run --outdir .worker-dist/realtime",
    "worker:build:astra": "wrangler deploy --config wrangler.astra.jsonc --dry-run --outdir .worker-dist/astra",
    "worker:deploy:realtime": "wrangler deploy --config wrangler.realtime.jsonc",
    "worker:deploy:astra": "wrangler deploy --config wrangler.astra.jsonc",
    "data:boundary": "node scripts/ingest-boundary.mjs",
    "data:lakes": "node scripts/ingest-lakes.mjs",
    "data:corridor": "node scripts/ingest-corridor-terrain.mjs",
    "data:corridor:kiental": "node scripts/ingest-kiental-corridor.mjs",
    "data:gtfs": "node scripts/ingest-gtfs.mjs",
    "data:rigi": "node scripts/build-rigi-study.mjs",
    "data:jungfrau": "node scripts/build-jungfrau-study.mjs",
    "data:rigi:terrain": "node scripts/ingest-rigi-terrain.mjs",
    "data:mountains": "node scripts/audit-mountain-transport.mjs",
    "data:rail:shapes": "node scripts/enrich-swiss-rail-geometry.mjs",
    "data:rail:repair-edges": "node scripts/backfill-swiss-rail-edge-paths.mjs",
    "data:day": "node scripts/ingest-gtfs.mjs --window-start 00:00 --window-end 24:00 --output public/data/swiss-rail-day-manifest.json --hub-output none --chunk-hours 3",
    "data:zurich": "node scripts/ingest-gtfs.mjs --modes all --bounds 8.45,47.32,8.63,47.44 --output public/data/zurich-city-morning.json --hub-output none",
    "data:zurich:shapes": "node scripts/enrich-zurich-shapes.mjs",
    "data:zurich:day": "node scripts/ingest-gtfs.mjs --window-start 00:00 --window-end 24:00 --focus 12:00 --modes tram --bounds 8.45,47.32,8.63,47.44 --output public/data/zurich-tram-day-manifest.json --hub-output none --chunk-hours 3",
    "data:zurich:day:shapes": "node scripts/enrich-zurich-shapes.mjs --snapshot public/data/zurich-tram-day-manifest.json",
    "data:zvv": "node scripts/ingest-gtfs.mjs --modes all --bounds 8.32,47.15,9.02,47.72 --output public/data/zvv-region-morning.json --hub-output none",
    "data:zvv:shapes": "node scripts/enrich-zurich-shapes.mjs --snapshot public/data/zvv-region-morning.json",
    "data:geneva": "node scripts/ingest-gtfs.mjs --modes all --bounds 5.90,46.05,6.35,46.38 --local-agencies 881 --output public/data/geneva-tpg-morning.json --hub-output none",
    "data:geneva:shapes": "node scripts/enrich-geneva-shapes.mjs --snapshot public/data/geneva-tpg-morning.json",
    "data:postbus:kiental": "node scripts/ingest-gtfs.mjs --window-start 00:00 --window-end 24:00 --focus 12:00 --modes rail,bus --bounds 7.67,46.52,7.79,46.65 --local-agencies 801 --local-route-ids 96-100-0-j26-1 --output public/data/kiental-postbus-day-manifest.json --hub-output none --chunk-hours 3",
    "data:postbus:analyze": "node scripts/analyze-postbus-corridors.mjs",
    "data:validate": "node scripts/validate-data-artifacts.mjs",
    "data:air": "node scripts/ingest-adsb-heatmap.mjs",
    "data:road": "node scripts/build-road-study.mjs",
    "data:road:topology": "node scripts/ingest-national-road-topology.mjs",
    "data:road:record": "node scripts/record-astra-traffic.mjs",
    "data:road:record:watch": "node scripts/record-astra-traffic.mjs --watch",
    "data:road:export": "node scripts/export-astra-r2.mjs",
    "data:road:compile": "node scripts/compile-astra-road-study.mjs",
    "data:road:compile:national": "node scripts/compile-astra-national-study.mjs",
    "preview": "vite preview",
    "data:air:routes": "node scripts/enrich-air-routes.mjs",
    "data:postbus:national": "node scripts/ingest-gtfs.mjs --window-start 00:00 --window-end 24:00 --focus 07:45 --modes bus --bounds -180,-90,180,90 --local-agencies 801 --output public/data/postbus-national-day-manifest.json --hub-output none --chunk-hours 3",
    "data:postbus:roads:prepare": "node scripts/prepare-postbus-road-feed.mjs",
    "data:postbus:roads:match": "node scripts/match-postbus-roads.mjs",
    "data:postbus:roads": "node scripts/enrich-postbus-roads.mjs --apply",
    "data:road:catalog:cantonal": "node scripts/ingest-cantonal-road-counters.mjs",
    "data:road:topology:cantonal": "node scripts/ingest-cantonal-road-topology.mjs",
    "data:regional:studies": "node scripts/package-regional-studies.mjs",
    "data:regional:days": "node scripts/build-regional-days.mjs",
    "data:vaud:audit": "node scripts/audit-vaud-study.mjs",
    "data:orbital": "node --max-old-space-size=8192 scripts/build-orbital-study.mjs",
    "data:bern:sources": "python3 scripts/prepare-bern-sources.py",
    "data:bern": "node --max-old-space-size=8192 scripts/build-bern-region.mjs",
    "data:bern:check": "node scripts/check-bern-region.mjs",
    "data:bern:release": "node scripts/build-bern-day.mjs",
    "data:bern:docs": "node scripts/document-bern-study.mjs",
    "data:luzern:census": "node scripts/luzern-timetable.mjs",
    "data:luzern": "node scripts/build-luzern-region.mjs",
    "data:luzern:check": "node scripts/check-luzern-region.mjs",
    "data:luzern:report": "node scripts/write-luzern-audit.mjs",
    "data:zug:sources": "python3 scripts/prepare-zug-sources.py",
    "data:zug:census": "node scripts/zug-timetable.mjs",
    "data:zug": "node scripts/build-zug-region.mjs data/zug-timetable.json.gz",
    "data:zug:check": "node scripts/check-zug-region.mjs",
    "data:zug:report": "node scripts/write-zug-audit.mjs",
    "data:solothurn:sources": "python3 scripts/prepare-solothurn-sources.py",
    "data:solothurn:census": "node --max-old-space-size=8192 scripts/solothurn-timetable.mjs",
    "data:solothurn": "node scripts/build-solothurn-region.mjs",
    "data:solothurn:check": "node scripts/check-solothurn-region.mjs",
    "data:solothurn:docs": "node scripts/document-solothurn-study.mjs",
    "data:st-gallen:sources": "python3 scripts/prepare-st-gallen-sources.py",
    "data:st-gallen:census": "node --max-old-space-size=8192 scripts/st-gallen-timetable.mjs",
    "data:st-gallen": "node --max-old-space-size=8192 scripts/build-st-gallen-region.mjs",
    "data:st-gallen:check": "node scripts/check-st-gallen-region.mjs",
    "data:st-gallen:report": "node scripts/document-st-gallen-study.mjs",
    "data:st-gallen:audit": "node scripts/check-st-gallen-region.mjs --audit-only",
    "data:thurgau:sources": "python3 scripts/prepare-thurgau-sources.py",
    "data:thurgau": "node --max-old-space-size=8192 scripts/build-thurgau-region.mjs",
    "data:thurgau:check": "node scripts/check-thurgau-region.mjs",
    "data:thurgau:docs": "node scripts/document-thurgau-study.mjs",
    "data:fribourg:sources": "python3 scripts/prepare-fribourg-sources.py",
    "data:fribourg:census": "node --max-old-space-size=8192 scripts/fribourg-timetable.mjs",
    "data:fribourg": "node --max-old-space-size=8192 scripts/build-fribourg-region.mjs",
    "data:fribourg:check": "node scripts/check-fribourg-region.mjs",
    "data:fribourg:docs": "node scripts/write-fribourg-audit.mjs",
    "data:solothurn:seasonal": "node scripts/audit-solothurn-seasonal.mjs",
    "data:solothurn:seasonal:check": "node scripts/check-solothurn-seasonal.mjs",
    "data:solothurn:alignments": "node scripts/review-solothurn-alignments.mjs",
    "data:solothurn:release": "node scripts/build-solothurn-day.mjs",
    "data:graubuenden:sources": "python3 scripts/prepare-graubuenden-sources.py",
    "data:graubuenden:census": "node --max-old-space-size=8192 scripts/graubuenden-timetable.mjs",
    "data:graubuenden": "node scripts/build-graubuenden-region.mjs",
    "data:graubuenden:check": "node scripts/check-graubuenden-region.mjs",
    "data:graubuenden:review": "node scripts/review-graubuenden-access-roads.mjs && node scripts/review-graubuenden-rail.mjs && node scripts/review-graubuenden-rail-completion.mjs && node scripts/review-graubuenden-cableways.mjs",
    "data:graubuenden:rail-sources": "python3 scripts/prepare-graubuenden-rail-review.py",
    "data:graubuenden:docs": "node scripts/document-graubuenden-study.mjs && node scripts/document-graubuenden-expansion.mjs && node scripts/document-graubuenden-rail-completion.mjs && node scripts/document-graubuenden-cableways.mjs",
    "data:valais:sources": "python3 scripts/prepare-valais-sources.py",
    "data:valais:census": "node --max-old-space-size=8192 scripts/valais-timetable.mjs",
    "data:valais": "node --max-old-space-size=8192 scripts/build-valais-region.mjs",
    "data:valais:check": "node --max-old-space-size=8192 scripts/check-valais-region.mjs",
    "data:valais:docs": "node scripts/document-valais-study.mjs",
    "data:graubuenden:seasonal": "node --max-old-space-size=8192 scripts/graubuenden-seasonal.mjs",
    "data:graubuenden:seasonal:check": "node --max-old-space-size=8192 scripts/check-graubuenden-seasonal.mjs",
    "data:ticino:census": "node --max-old-space-size=8192 scripts/inventory-ticino.mjs",
    "data:ticino": "node --max-old-space-size=8192 scripts/build-ticino-region.mjs",
    "data:ticino:check": "node scripts/check-ticino-region.mjs",
    "data:ticino:docs": "node scripts/document-ticino-study.mjs",
    "data:graubuenden:cableway-sources": "node scripts/prepare-graubuenden-cableways.mjs",
    "test:components": "vitest run src/test",
    "data:prepare": "node scripts/prepare-app-catalogues.mjs && node --max-old-space-size=8192 scripts/build-orbital-study.mjs",
    "data:release:prepare": "node scripts/data-release.mjs",
    "data:release:publish": "node scripts/publish-data-release.mjs",
    "build:fixtures": "VITE_GLEISLICHT_BUNDLE_DATA=1 npm run build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@driftbox/engine": "^0.6.0",
    "@motionstudies/core": "0.1.0-alpha.8",
    "@motionstudies/three": "0.1.0-alpha.8",
    "@motionstudies/web": "0.1.0-alpha.8",
    "@react-three/fiber": "^9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@babel/parser": "7.29.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@motionstudies/data": "0.1.0-alpha.8",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "geotiff": "^3.0.5",
    "gtfs-realtime-bindings": "^2.2.0",
    "jsdom": "^30.0.1",
    "oxlint": "1.82.0",
    "typescript": "~7.0.2",
    "vite": "8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "4.131.1"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
