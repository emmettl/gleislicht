{
  "name": "gleislicht",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Switzerland in motion — a cinematic railway visualisation built from Swiss open transport data.",
  "scripts": {
    "predev": "node scripts/stage-edition-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/stage-edition-data.mjs",
    "build": "tsc -b && vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:london": "node scripts/check-london-fixture-budget.mjs",
    "check:new-york": "node scripts/check-new-york-proof.mjs",
    "check:paris": "node scripts/check-paris-proof.mjs",
    "pages:prepare": "node scripts/prepare-pages-artifact.mjs",
    "check:architecture": "node scripts/check-edition-boundaries.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep-invert @frame-cadence && playwright test --grep @frame-cadence --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "worker:check": "tsc -p realtime-worker/tsconfig.json",
    "worker:build": "wrangler deploy --config wrangler.realtime.jsonc --dry-run --outdir .worker-dist",
    "data:boundary": "node scripts/ingest-boundary.mjs",
    "data:lakes": "node scripts/ingest-lakes.mjs",
    "data:corridor": "node scripts/ingest-corridor-terrain.mjs",
    "data:corridor:kiental": "node scripts/ingest-kiental-corridor.mjs",
    "data:gtfs": "node scripts/ingest-gtfs.mjs",
    "data:rail:shapes": "node scripts/enrich-swiss-rail-geometry.mjs",
    "data:rail:repair-edges": "node scripts/backfill-swiss-rail-edge-paths.mjs",
    "data:day": "node scripts/ingest-gtfs.mjs --window-start 00:00 --window-end 24:00 --output public/data/swiss-rail-day-manifest.json --hub-output none --chunk-hours 3",
    "data:zurich": "node scripts/ingest-gtfs.mjs --modes all --bounds 8.45,47.32,8.63,47.44 --output public/data/zurich-city-morning.json --hub-output none",
    "data:zurich:shapes": "node scripts/enrich-zurich-shapes.mjs",
    "data:zurich:day": "node scripts/ingest-gtfs.mjs --window-start 00:00 --window-end 24:00 --focus 12:00 --modes tram --bounds 8.45,47.32,8.63,47.44 --output public/data/zurich-tram-day-manifest.json --hub-output none --chunk-hours 3",
    "data:zurich:day:shapes": "node scripts/enrich-zurich-shapes.mjs --snapshot public/data/zurich-tram-day-manifest.json",
    "data:zvv": "node scripts/ingest-gtfs.mjs --modes all --bounds 8.32,47.15,9.02,47.72 --output public/data/zvv-region-morning.json --hub-output none",
    "data:zvv:shapes": "node scripts/enrich-zurich-shapes.mjs --snapshot public/data/zvv-region-morning.json",
    "data:geneva": "node scripts/ingest-gtfs.mjs --modes all --bounds 5.90,46.05,6.35,46.38 --local-agencies 881 --output public/data/geneva-tpg-morning.json --hub-output none",
    "data:geneva:shapes": "node scripts/enrich-geneva-shapes.mjs --snapshot public/data/geneva-tpg-morning.json",
    "data:postbus:kiental": "node scripts/ingest-gtfs.mjs --window-start 00:00 --window-end 24:00 --focus 12:00 --modes rail,bus --bounds 7.67,46.52,7.79,46.65 --local-agencies 801 --local-route-ids 96-100-0-j26-1 --output public/data/kiental-postbus-day-manifest.json --hub-output none --chunk-hours 3",
    "data:postbus:analyze": "node scripts/analyze-postbus-corridors.mjs",
    "data:validate": "node scripts/validate-data-artifacts.mjs",
    "data:air": "node scripts/ingest-adsb-heatmap.mjs",
    "data:road": "node scripts/build-road-study.mjs",
    "data:road:topology": "node scripts/ingest-national-road-topology.mjs",
    "data:road:record": "node scripts/record-astra-traffic.mjs",
    "data:road:record:watch": "node scripts/record-astra-traffic.mjs --watch",
    "data:road:compile": "node scripts/compile-astra-road-study.mjs",
    "data:road:compile:national": "node scripts/compile-astra-national-study.mjs",
    "data:london:proof": "node scripts/ingest-tfl-line.mjs --line bakerloo --direction outbound --origin 940GZZLUEAC --service-date 2026-09-04 --output fixtures/tfl/all-change-bakerloo-morning.json",
    "data:london:proof:dlr": "node scripts/ingest-tfl-line.mjs --line dlr --direction outbound --origin 940GZZDLBNK --service-date 2026-09-04 --output fixtures/tfl/all-change-dlr-bank-morning.json",
    "data:london:proof:tram": "node scripts/ingest-tfl-line.mjs --line tram --direction outbound --origin 940GZZCRBEK --service-date 2026-09-04 --output fixtures/tfl/all-change-tram-beckenham-morning.json",
    "data:london:proof:northern": "node scripts/ingest-tfl-line.mjs --line northern --direction outbound --origin 940GZZLUMDN --service-date 2026-09-04 --output fixtures/tfl/all-change-northern-morden-morning.json",
    "data:london:proof:lioness": "node scripts/ingest-tfl-pdf-timetable.mjs --line lioness --direction inbound --origin 910GWATFJDC --destination 910GEUSTON --section-title 'Lioness line southbound' --service-date 2026-09-04 --pdf-url https://content.tfl.gov.uk/lo-lioness-line-timetable-may-2026.pdf --first-page 2 --last-page 2 --valid-from 2026-05-17 --output fixtures/tfl/all-change-lioness-morning.json",
    "data:london:proof:lioness:northbound": "node scripts/ingest-tfl-pdf-timetable.mjs --line lioness --direction outbound --origin 910GEUSTON --destination 910GWATFJDC --section-title 'Lioness line northbound' --service-date 2026-09-04 --pdf-url https://content.tfl.gov.uk/lo-lioness-line-timetable-may-2026.pdf --first-page 7 --last-page 9 --valid-from 2026-05-17 --output fixtures/tfl/all-change-lioness-northbound-morning.json",
    "data:london:proof:elizabeth": "node scripts/ingest-tfl-pdf-timetable.mjs --line elizabeth --direction outbound --origin 910GABWDXR --destination 910GPADTLL --section-title 'Elizabeth line – Westbound' --service-date 2026-09-04 --pdf-url https://content.tfl.gov.uk/elizabeth-line-17-may-12-december-2026.pdf --first-page 2 --last-page 5 --valid-from 2026-05-17 --valid-until 2026-12-12 --output fixtures/tfl/all-change-elizabeth-morning.json",
    "data:london:proof:elizabeth:eastbound": "node scripts/ingest-tfl-pdf-timetable.mjs --line elizabeth --direction inbound --origin 910GPADTLL --destination 910GABWDXR --section-title 'Elizabeth line – Eastbound' --service-date 2026-09-04 --pdf-url https://content.tfl.gov.uk/elizabeth-line-17-may-12-december-2026.pdf --first-page 34 --last-page 37 --valid-from 2026-05-17 --valid-until 2026-12-12 --output fixtures/tfl/all-change-elizabeth-eastbound-morning.json",
    "data:london:proofs": "npm run data:london:proof && npm run data:london:proof:dlr && npm run data:london:proof:tram && npm run data:london:proof:northern && npm run data:london:proof:lioness && npm run data:london:proof:lioness:northbound && npm run data:london:proof:elizabeth && npm run data:london:proof:elizabeth:eastbound",
    "data:london:lattice:unified": "node scripts/compile-tfl-morning-lattice.mjs",
    "data:london:lattice:pdf": "node scripts/compile-tfl-pdf-lattice.mjs",
    "data:london:rank": "node scripts/rank-network-stations.mjs fixtures/tfl/all-change-rail-led-morning.json --catalogue fixtures/tfl/all-change-rail-led-catalogue.json",
    "data:london:geography": "node scripts/ingest-london-geography.mjs",
    "data:london:diagram": "node scripts/compile-london-diagram.mjs",
    "data:london:morning:assemble": "node scripts/merge-network-snapshots.mjs --retrieved-at 2026-09-06T12:00:00.000Z --note 'All advertised Tube, DLR and Tramlink lines in both directions, all six named London Overground lines in both directions, and a complete Elizabeth/Overground branch audit. Seven topology branches without direct morning timetable columns remain explicitly inactive in the PDF lattice metadata.' --output fixtures/tfl/all-change-rail-led-morning.json fixtures/tfl/all-change-unified-morning.json fixtures/tfl/all-change-pdf-morning.json && npm run data:london:rank && npm run data:london:diagram",
    "data:london:day:unified": "node scripts/compile-tfl-morning-lattice.mjs --service-date 2026-09-04 --retrieved-at 2026-09-06T12:00:00.000Z --window-start 00:00 --window-end 24:00 --output fixtures/tfl/all-change-unified-day.json",
    "data:london:day:pdf": "node scripts/compile-tfl-pdf-lattice.mjs --service-date 2026-09-04 --retrieved-at 2026-09-06T12:00:00.000Z --window-start 00:00 --window-end 24:00 --output fixtures/tfl/all-change-pdf-day.json",
    "data:london:day:assemble": "node scripts/merge-network-snapshots.mjs --retrieved-at 2026-09-06T12:00:00.000Z --note 'Complete audited Friday service day for all advertised Tube, DLR and Tramlink lines, all six named London Overground lines and the Elizabeth line branch family. TfL services whose published timetable crosses midnight remain attached to their originating service day.' --output fixtures/tfl/all-change-rail-led-day.json fixtures/tfl/all-change-unified-day.json fixtures/tfl/all-change-pdf-day.json && node scripts/rank-network-stations.mjs fixtures/tfl/all-change-rail-led-day.json --catalogue fixtures/tfl/all-change-rail-led-catalogue.json && node scripts/chunk-network-snapshot.mjs --input fixtures/tfl/all-change-rail-led-day.json --manifest fixtures/tfl/all-change-day-manifest.json --opening fixtures/tfl/all-change-rail-led-morning.json --chunk-hours 2 --opening-start 06:45 --opening-end 08:45 --focus 07:45 && npm run data:london:diagram",
    "data:london:day": "npm run data:london:day:unified && npm run data:london:day:pdf && npm run data:london:day:assemble",
    "data:london:assemble": "npm run data:london:day:assemble",
    "data:london:catalogue": "node scripts/ingest-tfl-rail-catalogue.mjs",
    "data:london:airports": "node scripts/enrich-airport-associations.mjs",
    "data:london:roads": "node scripts/compile-webtris-london-study.mjs",
    "data:london:surface": "node scripts/compile-tfl-surface-study.mjs",
    "data:london:bus": "node scripts/compile-tfl-bus-study.mjs && node scripts/chunk-network-snapshot.mjs --input fixtures/tfl/all-change-bus-day.json --manifest fixtures/tfl/all-change-bus-day-manifest.json --opening /tmp/all-change-bus-opening-check.json --chunk-hours 2 --opening-start 06:45 --opening-end 08:45 --focus 07:45",
    "data:new-york:proof": "node scripts/ingest-mta-lexington-proof.mjs",
    "data:new-york:geography": "node scripts/compile-new-york-geography.mjs",
    "data:new-york:diagram": "node scripts/compile-new-york-diagram.mjs",
    "data:new-york:day:chunk": "node scripts/chunk-network-snapshot.mjs --input fixtures/mta/local-express-lexington-day.json --manifest fixtures/mta/local-express-day-manifest.json --opening /tmp/local-express-opening-check.json --chunk-hours 2 --opening-start 07:00 --opening-end 09:00 --focus 08:00",
    "data:paris:proof": "node scripts/ingest-idfm-correspondances-proof.mjs --archive /tmp/IDFM-gtfs.zip --service-date 2026-09-04 --retrieved-at 2026-09-06T11:41:37.000Z",
    "data:paris:central-cross": "node scripts/ingest-idfm-correspondances-proof.mjs --study central-cross --archive /tmp/IDFM-gtfs-current.zip --service-date 2026-09-04 --retrieved-at 2026-09-06T11:41:37.000Z",
    "data:paris:central-cross:day": "node scripts/ingest-idfm-correspondances-proof.mjs --study central-cross --archive /tmp/IDFM-gtfs-current.zip --service-date 2026-09-04 --retrieved-at 2026-09-06T11:41:37.000Z --window-start 00:00:00 --window-end 24:00:00 --focus 12:00:00 --output /tmp/correspondances-central-cross-day.json && node scripts/chunk-network-snapshot.mjs --input /tmp/correspondances-central-cross-day.json --manifest fixtures/idfm/correspondances-central-cross-day-manifest.json --opening /tmp/correspondances-central-cross-opening-check.json --chunk-hours 2 --opening-start 07:00 --opening-end 09:00 --focus 08:00",
    "data:paris:regional-rer": "node scripts/ingest-idfm-correspondances-proof.mjs --study regional-rer --archive /tmp/IDFM-gtfs-current.zip --service-date 2026-09-04 --retrieved-at 2026-09-06T11:41:37.000Z",
    "data:paris:regional-rer:day": "node scripts/ingest-idfm-correspondances-proof.mjs --study regional-rer --archive /tmp/IDFM-gtfs-current.zip --service-date 2026-09-04 --retrieved-at 2026-09-06T11:41:37.000Z --window-start 00:00:00 --window-end 24:00:00 --focus 12:00:00 --output /tmp/correspondances-regional-rer-day.json && node scripts/chunk-network-snapshot.mjs --input /tmp/correspondances-regional-rer-day.json --manifest fixtures/idfm/correspondances-regional-rer-day-manifest.json --opening /tmp/correspondances-regional-rer-opening-check.json --chunk-hours 2 --opening-start 07:00 --opening-end 09:00 --focus 08:00",
    "data:paris:audit": "node scripts/audit-idfm-paris-scope.mjs --archive /tmp/IDFM-gtfs-current.zip --service-date 2026-09-04 --retrieved-at 2026-09-06T11:41:37.000Z",
    "data:paris:geography": "node scripts/compile-paris-geography.mjs --boundary /tmp/paris-boundary.geojson --water /tmp/paris-water.json --peripherique /tmp/paris-peripherique.json --retrieved-at 2026-09-06T13:16:00.000Z",
    "data:paris:day": "node scripts/ingest-idfm-correspondances-proof.mjs --archive /tmp/IDFM-gtfs.zip --service-date 2026-09-04 --retrieved-at 2026-09-06T11:41:37.000Z --window-start 00:00:00 --window-end 24:00:00 --focus 12:00:00 --output /tmp/correspondances-day.json && node scripts/chunk-network-snapshot.mjs --input /tmp/correspondances-day.json --manifest fixtures/idfm/correspondances-day-manifest.json --opening /tmp/correspondances-opening-check.json --chunk-hours 2 --opening-start 07:00 --opening-end 09:00 --focus 08:00",
    "data:stage": "node scripts/stage-edition-data.mjs",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@driftbox/engine": "^0.6.0",
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "geotiff": "^3.0.5",
    "gtfs-realtime-bindings": "^2.2.0",
    "oxlint": "^1.81.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
