{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gleislicht-road-daily",
  "main": "road-daily-worker/index.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["17 3,6 * * *"] },
  "limits": { "cpu_ms": 300000, "subrequests": 5000 },
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "OBSERVATIONS", "bucket_name": "gleislicht-observations" }]
}
