{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gleislicht-realtime",
  "main": "realtime-worker/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "OBSERVATIONS",
      "bucket_name": "gleislicht-observations"
    }
  ],
  "vars": {
    "STATIC_FEED_VERSION": "20260902",
    "ALLOWED_ORIGINS": "https://motionstudies.app,https://emmettl.github.io,http://127.0.0.1:5173,http://localhost:5173"
  }
}
